APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Matches deployments/docker-compose.yml (host port 5433 → container 5432)
DATABASE_URL=postgres://postgres:root@127.0.0.1:5433/ws?sslmode=disable

# Comma-separated. Vite dev server default is 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
